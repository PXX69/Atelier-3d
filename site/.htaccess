# À la racine du site. Si votre domaine pointe sur le dossier « public », ce fichier n'est pas utilisé.
# S'il pointe sur le dossier qui contient « public », il envoie les visiteurs vers « public » et bloque le reste.
Options -Indexes -MultiViews

<FilesMatch "(^config(\.sample)?\.php$|\.(md|log|pem|sqlite|db|sql|bak|json|jsonl)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteCond %{SERVER_PORT} !^443$
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  RewriteRule ^(src|storage|tools|test)(/|$) - [F,L]
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
  RewriteRule ^(.*)$ public/$1 [L]
  RewriteRule ^(?!public/) public/index.php [L]
</IfModule>
